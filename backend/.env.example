DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen3.7-max
QWEN_TITLE_MODEL=qwen-flash
QWEN_CONTEXT_WINDOW=131072
# Seconds without a streamed chunk before a model call is retried (library default 120).
# QWEN_STREAM_CHUNK_TIMEOUT=180
# Attempts per model call for transient provider failures (stream stalls, 429, 5xx).
# WDRUNGE_MODEL_RETRIES=3
# After those retries: one non-streaming attempt, then this fallback model (optional).
# QWEN_FALLBACK_MODEL=qwen-plus
# Cap output tokens per response (optional; long files should be written in parts).
# QWEN_MAX_OUTPUT_TOKENS=16384
# Pause starting new tasks for 60 s after this many provider failures within 90 s.
# WDRUNGE_PROVIDER_BREAKER=4
# Model routing (all optional; default QWEN_MODEL): by purpose, by role, for small goals.
# Context summaries run with thinking disabled (WDRUNGE_SUMMARY_THINKING=1 enables it).
WDRUNGE_MODEL_SUMMARY=qwen3.7-plus
# WDRUNGE_MODEL_PRODUCT=qwen-plus
# WDRUNGE_MODEL_SMALL_TASKS=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional. Defaults to the operating system's Wdrunge application-data directory.
# WDRUNGE_DATABASE_PATH=/absolute/path/to/wdrunge.db

# Small model used for automatic approval (>=75% confidence, otherwise HITL).
WDRUNGE_REVIEW_MODEL=qwen-flash
