{
  "openapi": "3.1.0",
  "info": {
    "title": "Wdrunge API",
    "description": "Agent team API. Requests are validated with Pydantic; work streams as SSE.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/validate": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Validate Workspace",
        "operationId": "validate_workspace_api_workspaces_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/team": {
      "get": {
        "tags": [
          "Agent"
        ],
        "summary": "Team Status",
        "description": "List every team member and its current state and capabilities.",
        "operationId": "team_status_api_team_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "tags": [
          "Agent"
        ],
        "summary": "Stream a leader-coordinated team response",
        "description": "Send the full conversation, ending with a user message, and the absolute `workspace_path` selected for this conversation. Supply the same `conversation_id` to continue worker sessions and Leader checkpoints; omit it for an isolated request. `status` events report agent state; `chat_message` contains short team updates; `read_receipt` marks an @mention as read; `activity` describes tool use without arguments; `usage` reports cumulative tokens and each agent's latest prompt context occupancy; `delta` contains the Leader's reply; `done` marks completion. Failures after streaming begins emit `error` with `{message}`.",
        "operationId": "chat_stream_api_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "DASHSCOPE_API_KEY is not configured"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentUsageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens"
          },
          "context_tokens": {
            "type": "integer",
            "title": "Context Tokens"
          },
          "context_window": {
            "type": "integer",
            "title": "Context Window"
          },
          "context_percent": {
            "type": "number",
            "title": "Context Percent"
          }
        },
        "type": "object",
        "required": [
          "id",
          "total_tokens",
          "context_tokens",
          "context_window",
          "context_percent"
        ],
        "title": "AgentUsageResponse"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Messages"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "workspace_path": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Workspace Path"
          }
        },
        "type": "object",
        "required": [
          "messages",
          "workspace_path"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "TeamMemberResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "failed"
            ],
            "title": "Status"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "tools",
          "skills"
        ],
        "title": "TeamMemberResponse"
      },
      "TeamStatusResponse": {
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/TeamMemberResponse"
            },
            "type": "array",
            "title": "Agents"
          },
          "usage": {
            "$ref": "#/components/schemas/TeamUsageResponse"
          }
        },
        "type": "object",
        "required": [
          "agents",
          "usage"
        ],
        "title": "TeamStatusResponse"
      },
      "TeamUsageResponse": {
        "properties": {
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens"
          },
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentUsageResponse"
            },
            "type": "array",
            "title": "Agents"
          }
        },
        "type": "object",
        "required": [
          "total_tokens",
          "agents"
        ],
        "title": "TeamUsageResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceRequest": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "WorkspaceRequest"
      },
      "WorkspaceResponse": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "WorkspaceResponse"
      }
    }
  }
}
