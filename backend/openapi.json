    "/api/conversations/{conversation_id}/messages/stream": {
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Persist a message and stream the project team's response",
        "operationId": "conversation_message_stream_api_conversations__conversation_id__messages_stream_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Conversation not found"
          },
          "409": {
            "description": "Duplicate client message"
          },
          "503": {
            "description": "DASHSCOPE_API_KEY is not configured"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "tags": [
          "Agent"
        ],
        "summary": "Stream a leader-coordinated team response",
        "description": "Send the full conversation, ending with a user message, and the absolute `workspace_path` selected for this conversation. Supply the same `conversation_id` to continue worker sessions and Leader checkpoints; omit it for an isolated request. `status` events report agent state; `chat_message` contains short team updates; `read_receipt` marks an @mention as read; `activity` describes tool use without arguments; `usage` reports cumulative tokens and each agent's latest prompt context occupancy; `delta` contains the Leader's reply; `done` marks completion. Failures after streaming begins emit `error` with `{message}`.",
        "operationId": "chat_stream_api_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "DASHSCOPE_API_KEY is not configured"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentUsageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens"
          },
          "context_tokens": {
            "type": "integer",
            "title": "Context Tokens"
          },
          "context_window": {
            "type": "integer",
            "title": "Context Window"
          },
          "context_percent": {
            "type": "number",
            "title": "Context Percent"
          }
        },
        "type": "object",
        "required": [
          "id",
          "total_tokens",
          "context_tokens",
          "context_window",
          "context_percent"
        ],
        "title": "AgentUsageResponse"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Messages"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "workspace_path": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Workspace Path"
          }
        },
        "type": "object",
        "required": [
          "messages",
          "workspace_path"
        ],
        "title": "ChatRequest"
      },
      "Command": {
        "properties": {
          "member": {
            "type": "string",
            "enum": [
              "leader",
              "product",
              "backend",
              "frontend",
              "designer",
              "testing"
            ],
            "title": "Member",
            "default": "leader"
          },
          "conversation": {
            "type": "string",
            "title": "Conversation",
            "default": ""
          },
          "action": {
            "type": "string",
            "enum": [
              "catalog",
              "read",
              "publish",
              "subscribe",
              "send",
              "request",
              "inspect_request",
              "transition",
              "snapshot",
              "search",
              "diff",
              "schedule",
              "dependencies",
              "decision",
              "maintenance",
              "handoff",
              "recover",
              "inspect_message",
              "history"
            ],
            "title": "Action"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Command"
      },
      "ConversationCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1,
            "title": "Title",
            "default": "新对话"
          }
        },
        "type": "object",
        "title": "ConversationCreate"
      },
      "ConversationDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "project_name": {
            "type": "string",
            "title": "Project Name"
          },
          "workspace_path": {
            "type": "string",
            "title": "Workspace Path"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/PersistedMessageResponse"
            },
            "type": "array",
            "title": "Messages"
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/PersistedActivityResponse"
            },
            "type": "array",
            "title": "Activities"
          }
        },
        "type": "object",
        "required": [
          "id",
          "project_id",
          "title",
          "status",
          "created_at",
          "updated_at",
          "project_name",
          "workspace_path",
          "messages",
          "activities"
        ],
        "title": "ConversationDetailResponse"
      },
      "ConversationEventResponse": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "sequence",
          "type",
          "payload",
          "created_at"
        ],
        "title": "ConversationEventResponse"
      },
      "ConversationEventsResponse": {
        "properties": {
          "events": {
